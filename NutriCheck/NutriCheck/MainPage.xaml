<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriCheck.MainPage"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">
            
            <Label Text="NutriCheck" FontSize="28" FontAttributes="Bold" HorizontalOptions="Start" TextColor="#1A1A1A" />
            <Label Text="Kişiye Özel Beslenme Planlayıcısı" FontSize="14" TextColor="#666" Margin="0,-10,0,10" />

            <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="White" Padding="5">
                <Entry x:Name="txtBoy" Placeholder="Boyunuz (örn: 175)" Keyboard="Numeric" HeightRequest="50"/>
            </Border>

            <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="White" Padding="5">
                <Entry x:Name="txtKilo" Placeholder="Kilonuz (kg)" Keyboard="Numeric" HeightRequest="50"/>
            </Border>

            <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="White" Padding="5">
                <Picker x:Name="pckCinsiyet" Title="Cinsiyetiniz" HeightRequest="50">
                    <Picker.Items>
                        <x:String>Erkek</x:String>
                        <x:String>Kadın</x:String>
                    </Picker.Items>
                </Picker>
            </Border>

            <Label Text="Beslenme Tarzınızı Seçin:" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>
            <Picker x:Name="pckBeslenmeTarzi" Title="Tarz Seçiniz">
                <Picker.Items>
                    <x:String>Alternatif A (Geleneksel/Protein)</x:String>
                    <x:String>Alternatif B (Hafif/Enerji)</x:String>
                    <x:String>Alternatif C (Hızlı/Pratik)</x:String>
                </Picker.Items>
            </Picker>
            
            <Button Text="HESAPLA VE ANALİZ ET" 
                    Clicked="OnHesaplaClicked" 
                    BackgroundColor="#2ECC71" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="10" 
                    HeightRequest="55" />

            <Border Stroke="#2ECC71" StrokeThickness="2" StrokeShape="RoundRectangle 20" BackgroundColor="White" Padding="20" Margin="0,10">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="VKI SKORUNUZ" FontSize="14" HorizontalOptions="Center" TextColor="#7F8C8D" />
                    <Label x:Name="lblVkiSonuc" Text="--" FontSize="64" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#2980B9" />
                    <Label x:Name="lblDurum" Text="Durum" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#2980B9" />
                    <Label x:Name="lblKaloriOnerisi" Text="Veri bekleniyor..." HorizontalOptions="Center" TextColor="#7F8C8D" />
                </VerticalStackLayout>
            </Border>

            <Label Text="✨ NutriCheck Analizi" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#8E44AD" Margin="0,10" />

            <VerticalStackLayout Spacing="10">
                <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="White" Padding="15">
                    <HorizontalStackLayout Spacing="15">
                        <Label Text="KAHVALTI" BackgroundColor="#D6EAF8" TextColor="#2E86C1" Padding="10,5" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" />
                        <Label x:Name="lblKahvalti" Text="---" VerticalOptions="Center" LineBreakMode="WordWrap" MaximumWidthRequest="200" />
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="White" Padding="15">
                    <HorizontalStackLayout Spacing="15">
                        <Label Text="ÖĞLE" BackgroundColor="#D5F5E3" TextColor="#239B56" Padding="10,5" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" />
                        <Label x:Name="lblOgle" Text="---" VerticalOptions="Center" LineBreakMode="WordWrap" MaximumWidthRequest="200" />
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="White" Padding="15">
                    <HorizontalStackLayout Spacing="15">
                        <Label Text="AKŞAM" BackgroundColor="#FADBD8" TextColor="#B03A2E" Padding="10,5" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" />
                        <Label x:Name="lblAksam" Text="---" VerticalOptions="Center" LineBreakMode="WordWrap" MaximumWidthRequest="200" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="White" Padding="15">
                <HorizontalStackLayout Spacing="15">
                    <Label Text="ARA ÖĞÜN" BackgroundColor="#FEF9E7" TextColor="#F1C40F" Padding="10,5" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" />
                    <Label x:Name="lblAraOgun" Text="---" VerticalOptions="Center" LineBreakMode="WordWrap" MaximumWidthRequest="200" />
                </HorizontalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="#F4ECF7" Padding="15" Margin="0,10">
                <VerticalStackLayout>
                    <Label Text="👑 Asistan Önerisi:" FontAttributes="Bold" TextColor="#8E44AD" />
                    <Label x:Name="lblAsistanNotu" Text="Uykudan 3 saat önce yemek yemeyi kes." TextColor="#8E44AD" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Geliştirenler: Can Şahin, Ahmet Emirhan Kocaman, Efe Ümit Gündoğdu" 
                   FontSize="10" HorizontalOptions="Center" TextColor="Silver" HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>